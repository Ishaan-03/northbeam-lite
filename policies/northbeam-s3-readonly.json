{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListBucketItself",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::northbeam-dev-data-ishaan-<ACCOUNT_ID>-eu-north-1-an"
    },
    {
      "Sid": "AllowGetObjectsInside",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::northbeam-dev-data-ishaan-<ACCOUNT_ID>-eu-north-1-an/*"
    }
  ]
}
